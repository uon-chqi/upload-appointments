# Shared secrets for upload-appointments — TEMPLATE (no real values).
#
# These values are the same for every deployment. The real file (secrets.env)
# is gitignored. The encrypted form (secrets.env.gpg) is committed and is
# decrypted by deploy.sh using a passphrase entered at install time.
#
# To change a shared secret or rotate the passphrase:
#   1. cp secrets.env.example secrets.env   (or edit your existing secrets.env)
#   2. Fill in the real values below.
#   3. Re-encrypt:
#        gpg --batch --yes --pinentry-mode loopback --passphrase 'YOUR_PASSPHRASE' \
#            --symmetric --cipher-algo AES256 -o secrets.env.gpg secrets.env
#   4. Commit secrets.env.gpg only. Never commit secrets.env.
#
CHQI_API_USERNAME='changeme'
CHQI_API_PASSWORD='changeme'
DJANGO_ADMIN_PASSWORD='changeme'
